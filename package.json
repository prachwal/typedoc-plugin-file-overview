{
  "name": "typedoc-plugin-file-overview",
  "version": "0.1.0",
  "description": "TypeDoc plugin that renders structured file-level metadata blocks into markdown output.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "typedoc-plugin-file-overview-install": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "typedoc",
    "typedoc-plugin",
    "markdown",
    "documentation",
    "tsdoc"
  ],
  "dependencies": {
    "prompts": "^2.4.2"
  },
  "peerDependencies": {
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.11.0"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9"
  }
}
